{
  "name": "stylelint-config",
  "projectType": "library",
  "sourceRoot": "stylelint-config/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/stylelint-config"],
      "options": {
        "command": "node stylelint-config/build.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --test stylelint-config/test/*.test.mjs"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "dist/stylelint-config"
      }
    }
  },
  "tags": ["type:config"]
}
